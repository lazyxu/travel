# travel server environment. Active file: ~/.travel/config/.env
POSTGRES_PASSWORD=replace-with-random-value
TRAVEL_ADMIN_PASSWORD=
TRAVEL_SESSION_SECRET=replace-with-a-long-random-value

TRAVEL_BIND=0.0.0.0
TRAVEL_PORT=3080
TRAVEL_COOKIE_SECURE=0
TRAVEL_AUTH_DISABLED=1

TRAVEL_IMAGE=ghcr.io/lazyxu/travel:master
TRAVEL_POSTGRES_IMAGE=postgres:17-alpine
TRAVEL_VERSION=master
TRAVEL_POSTGRES_DATA_DIR=

TRAVEL_DB_POOL_MAX=10
TRAVEL_APP_MEMORY_LIMIT=512m
TRAVEL_APP_CPU_LIMIT=1.0
TRAVEL_APP_PIDS_LIMIT=256
TRAVEL_POSTGRES_MEMORY_LIMIT=512m
TRAVEL_POSTGRES_CPU_LIMIT=0.75
TRAVEL_POSTGRES_PIDS_LIMIT=256
TRAVEL_LOG_MAX_SIZE=10m
TRAVEL_LOG_MAX_FILES=5
TRAVEL_BACKUP_RETENTION_DAYS=7
